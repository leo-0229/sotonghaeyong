# GitHub Pages uses only public Supabase connection values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Project pages: /sotonghaeyong ; user pages/custom domain: leave empty.
NEXT_PUBLIC_BASE_PATH=
# Never enable on a deployed site. Demo login is also restricted to loopback hosts.
NEXT_PUBLIC_ENABLE_DEMO=false
